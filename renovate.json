{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 7am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"]
  },
  "packageRules": [
    {
      "description": "One PR per component, so each product team reviews their own updates",
      "matchFileNames": ["products/**"],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessageSuffix": "({{packageFileDir}})"
    },
    {
      "description": "Generated by `cdk sync`; the provider constraint lives in tools/cdk",
      "matchFileNames": ["products/*/deploy/**"],
      "enabled": false
    },
    {
      "description": "Keep uv in lockstep everywhere (mise, Dockerfiles, CI images)",
      "matchPackageNames": ["uv", "astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "groupName": "uv"
    },
    {
      "description": "Keep pnpm in lockstep (packageManager, mise, Dockerfiles)",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Low-risk updates merge themselves once CI passes",
      "matchUpdateTypes": ["patch", "digest", "lockFileMaintenance"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true
    },
    {
      "description": "Dev tooling minors are low risk too",
      "matchDepTypes": ["devDependencies", "dev"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "pnpm version pinned in Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "description": "uv installer version in .drone.yml",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.drone\\.yml$/"],
      "matchStrings": ["astral\\.sh/uv/(?<currentValue>[0-9.]+)/install\\.sh"],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    },
    {
      "description": "pnpm installs in .drone.yml",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.drone\\.yml$/"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ]
}
