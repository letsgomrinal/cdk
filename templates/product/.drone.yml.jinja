# Release pipeline for one product. Infra changes go through Atlantis on the PR;
# this pipeline only builds code and rolls it out.
#
#   push to main       -> build image once -> release to dev
#   drone promote prod -> release the SAME image to prod (no rebuild)
kind: pipeline
type: docker
name: {{ product }}

trigger:
  event: [push, promote]

steps:
  - name: test
    image: python:3.13-slim
    commands:
      - echo "run unit tests here"
    when:
      event: push

  - name: image
    image: plugins/docker
    settings:
      registry: {{ region }}-docker.pkg.dev
      repo: {{ region }}-docker.pkg.dev/{{ org_prefix }}-artifacts/products/{{ product }}
      tags: ${DRONE_COMMIT_SHA:0:12}
      username: _json_key
      password:
        from_secret: gar_push_key
    when:
      event: push
      branch: main

  - name: release-dev
    image: gcr.io/google.com/cloudsdktool/google-cloud-cli:stable
    environment:
      RELEASE_KEY:
        from_secret: drone_release_key   # key for drone-release@acme-cicd (see docs/CONVENTIONS.md)
      IMAGE: {{ region }}-docker.pkg.dev/{{ org_prefix }}-artifacts/products/{{ product }}:${DRONE_COMMIT_SHA:0:12}
    commands:
      - echo "$RELEASE_KEY" > /tmp/key.json && gcloud auth activate-service-account --key-file=/tmp/key.json
      - deploy/release.sh images {{ org_prefix }}-{{ product }}-dev {{ region }} {{ product }} "$IMAGE"
    when:
      event: push
      branch: main

  - name: release-prod
    image: gcr.io/google.com/cloudsdktool/google-cloud-cli:stable
    environment:
      RELEASE_KEY:
        from_secret: drone_release_key   # key for drone-release@acme-cicd (see docs/CONVENTIONS.md)
      IMAGE: {{ region }}-docker.pkg.dev/{{ org_prefix }}-artifacts/products/{{ product }}:${DRONE_COMMIT_SHA:0:12}
    commands:
      - echo "$RELEASE_KEY" > /tmp/key.json && gcloud auth activate-service-account --key-file=/tmp/key.json
      - deploy/release.sh images {{ org_prefix }}-{{ product }}-prod {{ region }} {{ product }} "$IMAGE"
    when:
      event: promote
      target: prod
