module "{{ product }}" {
  source = "git::https://github.com/letsgomrinal/cdk.git//modules/product?ref={{ kit_version }}"

  product             = "{{ product }}"
  team                = "{{ team }}"
  env                 = var.env
  project_id          = var.project_id
  region              = var.region
  vpc                 = var.vpc
  deployers           = var.deployers
  deletion_protection = var.deletion_protection

  # Add only the workload types you need. Each map can hold any number of workloads.
  # Full reference: https://github.com/letsgomrinal/cdk/blob/{{ kit_version }}/docs/CONVENTIONS.md

  services = {
    # api = {
    #   secret_env = { DB_URL = "{{ product }}-db-url" }
    #   invokers   = ["job/reconcile"]
    # }
  }

  jobs = {
    # nightly = {
    #   args      = ["nightly"]
    #   schedules = { daily = { cron = "0 2 * * *" } }
    #   access    = { buckets = { "{{ org_prefix }}-{{ product }}-exports-${var.env}" = "write" } }
    # }
  }

  worker_pools = {}
  functions    = {}
}

output "workloads" {
  value = module.{{ product }}.workloads
}
