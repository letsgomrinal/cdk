#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["ruamel.yaml>=0.18"]
# ///
"""cdk: scaffold, sync and release products in this monorepo.

  cdk new <product>                         interactive: pick web / api / jobs / workers / functions
  cdk new <product> --team T --add web:storefront:nextjs --add job:nightly-export
  cdk add <product> <kind> <name> [--template T]
  cdk remove <product> <name> [--keep-code] [-y]
  cdk list
  cdk sync [--check]                        regenerate deploy/, atlantis.yaml, .cdk/manifest.json
  cdk release <env> [--products a,b] [--components p/c] [--since REV | --all] [--dry-run]
  cdk promote <from-env> <to-env> [--products a,b] [--components p/c] [--dry-run]

Edit products/<product>/product.yaml by hand or with add/remove; both are fine.

Runs as a uv script: `tools/cdk ...` installs its own dependencies (pinned in
tools/cdk.lock) on first use. release/promote need only the standard library
(they read .cdk/manifest.json), so CI images with python3 + gcloud can run
`python3 tools/cdk release ...` without uv.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PRODUCTS_DIR = ROOT / "products"
TEMPLATES_DIR = ROOT / "templates" / "components"
MODULE_DIR = ROOT / "modules" / "product-spec"
MANIFEST = ROOT / ".cdk" / "manifest.json"
GENERATED = "# GENERATED by `tools/cdk sync`. Do not edit."

PRODUCT_RE = re.compile(r"^[a-z][a-z0-9]{1,9}$")
COMPONENT_RE = re.compile(r"^[a-z]([a-z0-9-]{0,13}[a-z0-9])?$")

# kind -> (Cloud Run type, type code, templates (first = default))
KINDS = {
    "web": ("service", "svc", ["nextjs", "react"]),
    "api": ("service", "svc", ["fastapi"]),
    "job": ("job", "job", ["python-job"]),
    "worker": ("worker-pool", "wp", ["python-worker"]),
    "function": ("function", "fn", ["python-function"]),
}

SNIPPETS = {
    "web": """\
kind: web
template: {template}
public: true          # internet-facing; delete this line to keep it internal
# calls: [backend]    # may invoke `backend`; its URL is injected as BACKEND_URL
""",
    "api": """\
kind: api
template: {template}
# secret_env: {{ DB_URL: {product}-db-url }}    # access to the secret is granted automatically
# access: {{ publish: [{product}-events] }}
""",
    "job": """\
kind: job
template: {template}
# schedules:
#   daily: {{ cron: "0 2 * * *", time_zone: Etc/UTC }}
# access: {{ buckets: {{ "{org}-{product}-exports-{{env}}": write }} }}
""",
    "worker": """\
kind: worker
template: {template}
instances: 1
# env: {{ SUBSCRIPTION: "projects/{{project}}/subscriptions/{product}-{name}" }}
# access: {{ subscribe: [{product}-{name}] }}
""",
    "function": """\
kind: function
template: {template}
# triggers:
#   upload:
#     event_type: google.cloud.storage.object.v1.finalized
#     filters: {{ bucket: "{org}-{product}-inbox-{{env}}" }}
""",
}

PRODUCT_HEADER = """\
# Infra for product "{product}". This file is the whole definition:
# add/remove components here (or with `tools/cdk add|remove`), then run `tools/cdk sync`.
# Reference: docs/PRODUCT_YAML.md
product: {product}
team: {team}
envs: [{envs}]

components: {{}}

# Per-env tweaks, shallow-merged into a component's settings:
# overrides:
#   prod:
#     backend: {{ min_instances: 2, memory: 1Gi }}
"""


# ------------------------------------------------------------------ helpers

def die(msg):
    sys.exit(f"cdk: {msg}")


def yaml():
    try:
        from ruamel.yaml import YAML
    except ImportError:
        die("this command needs ruamel.yaml: run it as `tools/cdk ...` or `uv run tools/cdk ...` (uv installs it)")
    y = YAML()
    y.preserve_quotes = True
    y.indent(mapping=2, sequence=4, offset=2)
    y.width = 120
    return y


def load_yaml(path):
    with open(path) as f:
        return yaml().load(f)


def platform():
    return load_yaml(ROOT / "platform.yaml")


def product_dir(name):
    return PRODUCTS_DIR / name


def find_products():
    """product name -> directory, for every product.yaml under products/."""
    found = {}
    for p in sorted(PRODUCTS_DIR.rglob("product.yaml")):
        if any(part.startswith(".") for part in p.relative_to(ROOT).parts):
            continue
        spec = load_yaml(p)
        name = spec.get("product")
        if name in found:
            die(f"product '{name}' defined twice: {found[name]} and {p.parent}")
        found[name] = p.parent
    return found


def check_product(spec, plat, where):
    errs = []
    name = spec.get("product", "")
    if not PRODUCT_RE.match(str(name)):
        errs.append("product must be 2-10 chars, [a-z][a-z0-9]*, no hyphens")
    if not spec.get("team"):
        errs.append("team is required")
    for e in spec.get("envs") or []:
        if e not in plat["envs"]:
            errs.append(f"env '{e}' isn't defined in platform.yaml")
    for cname, c in (spec.get("components") or {}).items():
        if not COMPONENT_RE.match(cname):
            errs.append(f"component '{cname}': names are 1-15 chars, [a-z0-9-], start with a letter")
        kind = (c or {}).get("kind")
        if kind not in KINDS:
            errs.append(f"component '{cname}': kind must be one of {', '.join(KINDS)}")
    if errs:
        die(f"{where}:\n  - " + "\n  - ".join(errs))


def git(*args):
    return subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True)


# ------------------------------------------------------------------ scaffolding

def scaffold_code(product, name, kind, template):
    src = TEMPLATES_DIR / template
    dst = product_dir(product) / name
    if dst.exists():
        print(f"  keep   {dst.relative_to(ROOT)}/ (already exists)")
        return
    shutil.copytree(src, dst)
    for f in dst.rglob("*"):
        if f.is_file():
            try:
                text = f.read_text()
            except UnicodeDecodeError:
                continue
            f.write_text(text.replace("__PRODUCT__", product).replace("__NAME__", name))
    print(f"  create {dst.relative_to(ROOT)}/  ({kind}, {template})")
    if (dst / "pyproject.toml").exists():
        uv_lock(dst)


def uv_lock(path):
    """Python components are uv projects; the Dockerfile builds with `uv sync --locked`."""
    if not shutil.which("uv"):
        print(f"  warn   uv not found: run `uv lock` in {path.relative_to(ROOT)}/ before the first build")
        return
    res = subprocess.run(["uv", "lock", "--quiet"], cwd=path, capture_output=True, text=True)
    if res.returncode != 0:
        print(f"  warn   `uv lock` failed in {path.relative_to(ROOT)}/:\n{res.stderr.strip()}")
    else:
        print(f"  lock   {(path / 'uv.lock').relative_to(ROOT)}")


def add_component(product, kind, name, template=None, quiet_sync=False):
    if kind not in KINDS:
        die(f"unknown kind '{kind}', pick one of: {', '.join(KINDS)}")
    templates = KINDS[kind][2]
    template = template or templates[0]
    if template not in templates:
        die(f"template '{template}' isn't available for {kind} (choose: {', '.join(templates)})")
    if not COMPONENT_RE.match(name):
        die(f"component name '{name}' must be 1-15 chars, [a-z0-9-], starting with a letter")

    path = product_dir(product) / "product.yaml"
    if not path.exists():
        die(f"no product '{product}' (expected {path.relative_to(ROOT)}); create it with `cdk new {product}`")
    if name in (load_yaml(path).get("components") or {}):
        die(f"{product} already has a component named '{name}'")

    snippet = SNIPPETS[kind].format(template=template, product=product, name=name, org=platform()["org"])
    text = insert_component(path.read_text(), name, snippet)
    if name not in (yaml().load(text).get("components") or {}):
        die(f"couldn't place '{name}' in {path.relative_to(ROOT)}; add it under components: by hand")
    path.write_text(text)
    print(f"  update {path.relative_to(ROOT)}  (+ {name}: {kind})")
    scaffold_code(product, name, kind, template)
    if not quiet_sync:
        sync()


# product.yaml is hand-edited, so add/remove edit the components block as text
# (comments and formatting elsewhere are left alone) and re-parse to verify.

def _components_block(lines):
    """(start, end): index of the `components:` line and one past its last indented line."""
    start = next((i for i, l in enumerate(lines) if re.match(r"^components:", l)), None)
    if start is None:
        return None, None
    end = start + 1
    last = start
    while end < len(lines):
        l = lines[end]
        if l.strip() and not l.startswith(" "):
            break  # next top-level key or column-0 comment
        if l.strip():
            last = end
        end += 1
    return start, last + 1


def _spaced(lines):
    """Keep one blank line between the components block and whatever follows it."""
    start, end = _components_block(lines)
    if start is not None and end < len(lines) and lines[end].strip():
        lines.insert(end, "")
    return "\n".join(lines).rstrip("\n") + "\n"


def insert_component(text, name, snippet):
    lines = text.splitlines()
    start, end = _components_block(lines)
    body = [f"  {name}:"] + ["    " + l if l else "" for l in snippet.rstrip().splitlines()]
    if start is None:
        lines += ["", "components:"] + body
    else:
        if re.match(r"^components:\s*\{\s*\}\s*(#.*)?$", lines[start]):
            lines[start] = "components:"
        elif end > start + 1:
            body = [""] + body
        lines[end:end] = body
    return _spaced(lines)


def delete_component(text, name):
    lines = text.splitlines()
    start, end = _components_block(lines)
    i = next((j for j in range(start + 1, end) if re.match(rf"^  {re.escape(name)}:", lines[j])), None)
    if i is None:
        return None
    j = i + 1
    while j < end and (not lines[j].strip() or lines[j].startswith("   ")):
        j += 1
    while j > i + 1 and not lines[j - 1].strip():
        j -= 1  # keep the blank line separating the next component
    del lines[i:j]
    while i < len(lines) and i > 0 and not lines[i - 1].strip() and not lines[i].strip():
        del lines[i]
    start, end = _components_block(lines)
    while start + 1 < len(lines) and not lines[start + 1].strip():
        del lines[start + 1]
    start, end = _components_block(lines)
    if not any(l.strip() and not l.strip().startswith("#") for l in lines[start + 1:end]):
        lines[start] = "components: {}"
    return _spaced(lines)


def ask(prompt, default=""):
    suffix = f" [{default}]" if default else ""
    try:
        val = input(f"{prompt}{suffix}: ").strip()
    except EOFError:
        val = ""
    return val or default


def cmd_new(args):
    product = args.product
    if not PRODUCT_RE.match(product):
        die("product must be 2-10 chars, [a-z][a-z0-9]*, no hyphens (it prefixes every SA name)")
    if product in find_products():
        die(f"product '{product}' already exists")
    plat = platform()
    adds = [a.split(":") for a in (args.add or [])]
    interactive = not args.team and not adds and sys.stdin.isatty()

    team = args.team
    envs = args.envs.split(",") if args.envs else list(plat["envs"])
    if interactive:
        print(f"New product '{product}'. Press enter to skip a question.\n")
        team = ask("Owning team")
        envs = [e.strip() for e in ask("Environments", ",".join(envs)).split(",") if e.strip()]
        web = ask("Web frontend? (nextjs / react / no)", "no")
        if web != "no":
            adds.append(["web", ask("  name", "web"), web])
        api = ask("API backend? (fastapi / no)", "no")
        if api != "no":
            adds.append(["api", ask("  name", "api"), api])
        for kind, label in [("job", "Background jobs"), ("worker", "Worker pools"), ("function", "Functions")]:
            names = ask(f"{label}? names, comma-separated", "none")
            if names != "none":
                adds += [[kind, n.strip()] for n in names.split(",") if n.strip()]
    if not team:
        die("--team is required")
    for e in envs:
        if e not in plat["envs"]:
            die(f"env '{e}' isn't in platform.yaml (have: {', '.join(plat['envs'])})")

    d = product_dir(product)
    d.mkdir(parents=True)
    (d / "product.yaml").write_text(PRODUCT_HEADER.format(product=product, team=team, envs=", ".join(envs)))
    print(f"  create {(d / 'product.yaml').relative_to(ROOT)}")
    for a in adds:
        if len(a) < 2:
            die(f"--add expects kind:name[:template], got {':'.join(a)}")
        add_component(product, a[0], a[1], a[2] if len(a) > 2 else None, quiet_sync=True)
    sync()
    print(f"\nNext: review products/{product}/product.yaml, commit, and open a PR (Atlantis plans it).")


def cmd_add(args):
    add_component(args.product, args.kind, args.name, args.template)


def cmd_remove(args):
    path = product_dir(args.product) / "product.yaml"
    if not path.exists():
        die(f"no product '{args.product}'")
    spec = load_yaml(path)
    comps = spec.get("components") or {}
    if args.name not in comps:
        die(f"{args.product} has no component '{args.name}' (have: {', '.join(comps) or 'none'})")
    code = product_dir(args.product) / args.name
    if not args.yes:
        what = f"'{args.name}' from product.yaml" + ("" if args.keep_code or not code.exists() else f" and delete {code.relative_to(ROOT)}/")
        if ask(f"Remove {what}? (y/N)", "n").lower() != "y":
            die("aborted")
    text = delete_component(path.read_text(), args.name)
    if text is None or args.name in (yaml().load(text).get("components") or {}):
        die(f"couldn't find '  {args.name}:' under components: in {path.relative_to(ROOT)}; remove it by hand")
    path.write_text(text)
    leftover = [e for e, o in (spec.get("overrides") or {}).items() if o and args.name in o]
    print(f"  update {path.relative_to(ROOT)}  (- {args.name})")
    if code.exists() and not args.keep_code:
        shutil.rmtree(code)
        print(f"  delete {code.relative_to(ROOT)}/")
    sync()
    if leftover:
        print(f"\nAlso remove overrides for '{args.name}' under: {', '.join('overrides.' + e for e in leftover)}")
    plat = platform()
    protected = [e for e in spec.get("envs", []) if plat["envs"][e].get("deletion_protection", True)]
    if protected:
        print(f"\nNote: deletion protection is on in {', '.join(protected)}. The Atlantis apply there will refuse to "
              "delete the Cloud Run resource until protection is lifted for that apply (ask the platform team).")


def cmd_list(args):
    for name, d in find_products().items():
        spec = load_yaml(d / "product.yaml")
        print(f"{name}  ({spec.get('team')}; envs: {', '.join(spec.get('envs') or [])})  {d.relative_to(ROOT)}")
        for cname, c in (spec.get("components") or {}).items():
            kind = c.get("kind")
            typ, code, _ = KINDS.get(kind, ("?", "?", []))
            print(f"  {cname:16} {kind:9} -> {typ:12} {name}-{cname}-{code}")


# ------------------------------------------------------------------ sync

def render_deploy(product, d, plat):
    """Generated files in products/<p>/deploy/. Identical for every product apart from paths."""
    deploy = d / "deploy"
    rel_root = os.path.relpath(ROOT, deploy)
    rel_module = os.path.relpath(MODULE_DIR, deploy)
    files = {
        "main.tf": f"""{GENERATED}
# Infra lives in ../product.yaml (components) and {rel_root}/platform.yaml (shared settings).

terraform {{
  required_version = ">= 1.6"
  required_providers {{
    google = {{ source = "hashicorp/google", version = "~> 8.11" }}
  }}
  # bucket + prefix come from backend.<env>.hcl (Atlantis passes it at init)
  backend "gcs" {{}}
}}

provider "google" {{}}

variable "env" {{
  type = string
}}

module "product" {{
  source   = "{rel_module}"
  spec     = yamldecode(file("${{path.module}}/../product.yaml"))
  platform = yamldecode(file("${{path.module}}/{rel_root}/platform.yaml"))
  env      = var.env
}}

output "workloads" {{
  value = module.product.workloads
}}
""",
    }
    spec = load_yaml(d / "product.yaml")
    for env in spec.get("envs") or []:
        files[f"backend.{env}.hcl"] = (
            f"{GENERATED}\nbucket = \"{plat['envs'][env]['state_bucket']}\"\nprefix = \"products/{product}\"\n"
        )
    return {deploy / k: v for k, v in files.items()}


def render_atlantis(products, plat):
    lines = [GENERATED, "version: 3", "automerge: false", "parallel_plan: true", "parallel_apply: false", "projects:"]
    for name, d in products.items():
        spec = load_yaml(d / "product.yaml")
        deploy = d / "deploy"
        rel_root = os.path.relpath(ROOT, deploy)
        rel_modules = os.path.relpath(ROOT / "modules", deploy)
        for env in spec.get("envs") or []:
            lines += [
                f"  - name: {name}-{env}",
                f"    dir: {deploy.relative_to(ROOT)}",
                f"    workspace: {env}",
                "    workflow: cdk",
                "    autoplan:",
                "      enabled: true",
                f'      when_modified: ["*.tf", "backend.{env}.hcl", "../product.yaml", '
                f'"{rel_root}/platform.yaml", "{rel_modules}/**/*.tf"]',
            ]
    return "\n".join(lines) + "\n"


def render_manifest(products, plat):
    out = {
        "registry": plat["registry"],
        "build_project": plat["build_project"],
        "products": {},
    }
    for name, d in products.items():
        spec = load_yaml(d / "product.yaml")
        projects = dict(spec.get("projects") or {})
        envs = list(spec.get("envs") or [])
        out["products"][name] = {
            "region": spec.get("region") or plat["region"],
            "projects": {e: projects.get(e, f"{plat['org']}-{name}-{e}") for e in envs},
            "components": {
                c: {
                    "kind": v["kind"],
                    "type": KINDS[v["kind"]][0],
                    "workload": f"{name}-{c}-{KINDS[v['kind']][1]}",
                    "path": str((d / c).relative_to(ROOT)),
                }
                for c, v in (spec.get("components") or {}).items()
            },
        }
    return json.dumps(out, indent=2, sort_keys=True) + "\n"


def sync(check=False):
    plat = platform()
    products = find_products()
    wanted = {}
    for name, d in products.items():
        check_product(load_yaml(d / "product.yaml"), plat, d.relative_to(ROOT) / "product.yaml")
        wanted.update(render_deploy(name, d, plat))
    wanted[ROOT / "atlantis.yaml"] = render_atlantis(products, plat)
    wanted[MANIFEST] = render_manifest(products, plat)

    # generated files that should no longer exist (e.g. a removed env's backend file)
    stale = [
        p for d in products.values() for p in (d / "deploy").glob("backend.*.hcl") if p not in wanted
    ]

    changed = [p for p, content in wanted.items() if not p.exists() or p.read_text() != content]
    if check:
        if changed or stale:
            die("generated files are out of date, run `tools/cdk sync`:\n  "
                + "\n  ".join(str(p.relative_to(ROOT)) for p in changed + stale))
        print("generated files are up to date")
        return
    for p in changed:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(wanted[p])
        print(f"  sync   {p.relative_to(ROOT)}")
    for p in stale:
        p.unlink()
        print(f"  delete {p.relative_to(ROOT)}")


def cmd_sync(args):
    sync(check=args.check)


# ------------------------------------------------------------------ release / promote (stdlib only)

PLACEHOLDER_IMAGES = "us-docker.pkg.dev/cloudrun/container/"


def manifest():
    if not MANIFEST.exists():
        die(".cdk/manifest.json missing, run `tools/cdk sync`")
    return json.loads(MANIFEST.read_text())


def run(cmd, dry_run, capture=False):
    print("  $ " + " ".join(cmd), flush=True)
    if dry_run:
        return ""
    res = subprocess.run(cmd, check=True, text=True, capture_output=capture)
    return res.stdout if capture else ""


def gcloud_run(typ):
    return {
        "service": ["gcloud", "run", "services"],
        "function": ["gcloud", "run", "services"],
        "job": ["gcloud", "run", "jobs"],
        "worker-pool": ["gcloud", "beta", "run", "worker-pools"],
    }[typ]


def deploy_image(comp, project, region, image, dry_run):
    verb = "deploy" if comp["type"] == "worker-pool" else "update"
    run(gcloud_run(comp["type"]) + [verb, comp["workload"], "--image", image,
                                    "--project", project, "--region", region, "--quiet"], dry_run)


def current_image(comp, project, region, dry_run):
    out = run(gcloud_run(comp["type"]) + ["describe", comp["workload"], "--project", project,
                                          "--region", region, "--format=json"], dry_run, capture=True)
    if dry_run:
        return "<image currently running>"

    def find(node):
        if isinstance(node, dict):
            if isinstance(node.get("containers"), list) and node["containers"]:
                return node["containers"][0].get("image")
            for v in node.values():
                r = find(v)
                if r:
                    return r
        elif isinstance(node, list):
            for v in node:
                r = find(v)
                if r:
                    return r
        return None

    return find(json.loads(out))


def changed_paths(since):
    if not since or set(since) == {"0"} or git("cat-file", "-e", f"{since}^{{commit}}").returncode != 0:
        return None  # unknown -> caller releases everything
    res = git("diff", "--name-only", f"{since}...HEAD")
    if res.returncode != 0:
        return None
    return [l for l in res.stdout.splitlines() if l]


def select(m, env, products_arg, components_arg, since=None, all_=False):
    """[(product, component_name, component, project, region)] for this env."""
    products = [p for p in (products_arg or os.environ.get("PRODUCTS", "")).split(",") if p]
    comps = [c for c in (components_arg or os.environ.get("COMPONENTS", "")).split(",") if c]
    paths = None if all_ or products or comps else changed_paths(since)
    if paths is not None:
        print(f"changed since {since[:12]}: {len(paths)} file(s)")
    for p in products:
        if p not in m["products"]:
            die(f"unknown product '{p}'")

    out = []
    for pname, prod in sorted(m["products"].items()):
        if products and pname not in products:
            continue
        if env not in prod["projects"]:
            continue
        for cname, comp in sorted(prod["components"].items()):
            if comps and f"{pname}/{cname}" not in comps and cname not in comps:
                continue
            if paths is not None and not any(f == comp["path"] or f.startswith(comp["path"] + "/") for f in paths):
                continue
            out.append((pname, cname, comp, prod["projects"][env], prod["region"]))
    return out


def cmd_release(args):
    m = manifest()
    since = args.since or os.environ.get("DRONE_COMMIT_BEFORE")
    targets = select(m, args.env, args.products, args.components, since, args.all)
    if not targets:
        print(f"nothing to release to {args.env}")
        return
    sha = (os.environ.get("DRONE_COMMIT_SHA") or git("rev-parse", "HEAD").stdout.strip())[:12]
    for pname, cname, comp, project, region in targets:
        image = f"{m['registry']}/{pname}/{cname}:{sha}"
        print(f"\n== {pname}/{cname} ({comp['kind']}) -> {comp['workload']} in {project}")
        if not args.no_build:
            run(["gcloud", "builds", "submit", comp["path"], "--tag", image,
                 "--project", m["build_project"], "--quiet"], args.dry_run)
        deploy_image(comp, project, region, image, args.dry_run)


def cmd_promote(args):
    m = manifest()
    targets = select(m, args.to_env, args.products, args.components, all_=True)
    for pname, cname, comp, project, region in targets:
        src_project = m["products"][pname]["projects"].get(args.from_env)
        if not src_project:
            continue
        print(f"\n== {pname}/{cname}: {args.from_env} -> {args.to_env}")
        image = current_image(comp, src_project, region, args.dry_run)
        if not image or image.startswith(PLACEHOLDER_IMAGES):
            print(f"  skip: never released to {args.from_env}")
            continue
        deploy_image(comp, project, region, image, args.dry_run)


# ------------------------------------------------------------------ main

def main():
    ap = argparse.ArgumentParser(prog="cdk", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("new", help="create a product (interactive without flags)")
    p.add_argument("product")
    p.add_argument("--team")
    p.add_argument("--envs", help="comma-separated, default: all envs in platform.yaml")
    p.add_argument("--add", action="append", metavar="KIND:NAME[:TEMPLATE]",
                   help=f"component to add; kinds: {', '.join(KINDS)}")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("add", help="add a component to a product")
    p.add_argument("product")
    p.add_argument("kind", choices=list(KINDS))
    p.add_argument("name")
    p.add_argument("--template", help="; ".join(f"{k}: {'|'.join(v[2])}" for k, v in KINDS.items()))
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("remove", help="remove a component from a product")
    p.add_argument("product")
    p.add_argument("name")
    p.add_argument("--keep-code", action="store_true")
    p.add_argument("-y", "--yes", action="store_true")
    p.set_defaults(fn=cmd_remove)

    p = sub.add_parser("list", help="list products and components")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("sync", help="regenerate deploy/, atlantis.yaml and .cdk/manifest.json")
    p.add_argument("--check", action="store_true", help="fail if anything is out of date (CI)")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("release", help="build changed components and deploy them to an env")
    p.add_argument("env")
    p.add_argument("--products", help="default: $PRODUCTS")
    p.add_argument("--components", help="product/component or component, comma-separated")
    p.add_argument("--since", help="git rev to diff against (default: $DRONE_COMMIT_BEFORE)")
    p.add_argument("--all", action="store_true", help="ignore changes, release everything")
    p.add_argument("--no-build", action="store_true", help="deploy an already-built image for this commit")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_release)

    p = sub.add_parser("promote", help="deploy the images running in one env to another")
    p.add_argument("from_env")
    p.add_argument("to_env")
    p.add_argument("--products", help="default: $PRODUCTS, else all")
    p.add_argument("--components")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_promote)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
