{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "function.schema.json",
  "title": "deployment.yml (function)",
  "description": "A function: event-triggered handler. Runs as a Cloud Run function. Reference: docs/DEPLOYMENT_YML.md",
  "type": [
    "object",
    "null"
  ],
  "additionalProperties": false,
  "properties": {
    "template": {
      "type": "string",
      "description": "Scaffold this was created from (informational)"
    },
    "resources": {
      "type": "object",
      "description": "CPU and memory per instance",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ],
          "description": "vCPUs: \"1\", \"2\", \"4\", \"8\" (services also \"0.5\")"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$",
          "description": "e.g. 512Mi, 2Gi"
        }
      }
    },
    "scaling": {
      "type": "object",
      "description": "Autoscaling",
      "additionalProperties": false,
      "properties": {
        "min_instances": {
          "type": "integer",
          "minimum": 0,
          "description": "Default 0 (scale to zero)"
        },
        "max_instances": {
          "type": "integer",
          "minimum": 1,
          "description": "Default 10"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "Requests per instance (default 80; functions 1)"
        }
      }
    },
    "timeout": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]+s$",
      "description": "Request timeout (default 300s)"
    },
    "network": {
      "type": "object",
      "description": "Networking",
      "additionalProperties": false,
      "properties": {
        "ingress": {
          "enum": [
            "internal",
            "load-balancer",
            "all"
          ],
          "description": "Who can reach it on the network"
        },
        "egress": {
          "enum": [
            "private-ranges",
            "all-traffic",
            "none"
          ],
          "description": "Outbound via the env's VPC: private IPs only (default), all traffic, or no VPC"
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Env vars: a value, or a Secret Manager secret. ENV, PRODUCT, COMPONENT are always set.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "object",
            "description": "Secret reference. Access to the secret is granted automatically.",
            "additionalProperties": false,
            "properties": {
              "secret": {
                "type": "string",
                "description": "Secret ID, or \"projects/p/secrets/x\""
              },
              "version": {
                "type": [
                  "string",
                  "integer"
                ],
                "description": "Default: latest"
              }
            },
            "required": [
              "secret"
            ]
          }
        ]
      }
    },
    "labels": {
      "type": "object",
      "description": "GCP labels on this component's resources (cost reports, filtering). platform.yaml labels and the standard ones are added automatically.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,62}$",
        "not": {
          "enum": [
            "product",
            "workload",
            "workload-type",
            "env",
            "team",
            "managed-by"
          ]
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{0,63}$"
      }
    },
    "permissions": {
      "type": "object",
      "description": "IAM for this component's service account, granted on each resource",
      "additionalProperties": false,
      "properties": {
        "public": {
          "type": "boolean",
          "description": "Anyone on the internet may call it (allUsers invoker)"
        },
        "invokers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may call it: component names or IAM members"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "secretAccessor on each secret (env secrets are granted already)"
        },
        "buckets": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "read",
              "write",
              "admin"
            ]
          },
          "description": "bucket: read | write | admin"
        },
        "publish": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "pubsub.publisher on each topic"
        },
        "subscribe": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "pubsub.subscriber on each subscription"
        },
        "bigquery_datasets": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "read",
              "write"
            ]
          },
          "description": "\"dataset\" or \"project:dataset\": read | write"
        },
        "project_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Escape hatch: project-wide roles (reviewed)"
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Apps/apis/functions this calls: grants run.invoker and injects <NAME>_URL"
    },
    "triggers": {
      "type": "object",
      "description": "Eventarc triggers",
      "additionalProperties": {
        "type": "object",
        "description": "One trigger",
        "additionalProperties": false,
        "properties": {
          "event_type": {
            "type": "string",
            "description": "e.g. google.cloud.storage.object.v1.finalized"
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "pubsub_topic": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "event_type"
        ]
      }
    },
    "environments": {
      "type": "object",
      "description": "Per-env settings, deep-merged over the above (lists are replaced)",
      "propertyNames": {
        "enum": [
          "dev",
          "prod"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resources": {
            "type": "object",
            "description": "CPU and memory per instance",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "vCPUs: \"1\", \"2\", \"4\", \"8\" (services also \"0.5\")"
              },
              "memory": {
                "type": "string",
                "pattern": "^[0-9]+(Mi|Gi)$",
                "description": "e.g. 512Mi, 2Gi"
              }
            }
          },
          "scaling": {
            "type": "object",
            "description": "Autoscaling",
            "additionalProperties": false,
            "properties": {
              "min_instances": {
                "type": "integer",
                "minimum": 0,
                "description": "Default 0 (scale to zero)"
              },
              "max_instances": {
                "type": "integer",
                "minimum": 1,
                "description": "Default 10"
              },
              "concurrency": {
                "type": "integer",
                "minimum": 1,
                "description": "Requests per instance (default 80; functions 1)"
              }
            }
          },
          "timeout": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^[0-9]+s$",
            "description": "Request timeout (default 300s)"
          },
          "network": {
            "type": "object",
            "description": "Networking",
            "additionalProperties": false,
            "properties": {
              "ingress": {
                "enum": [
                  "internal",
                  "load-balancer",
                  "all"
                ],
                "description": "Who can reach it on the network"
              },
              "egress": {
                "enum": [
                  "private-ranges",
                  "all-traffic",
                  "none"
                ],
                "description": "Outbound via the env's VPC: private IPs only (default), all traffic, or no VPC"
              }
            }
          },
          "env": {
            "type": "object",
            "description": "Env vars: a value, or a Secret Manager secret. ENV, PRODUCT, COMPONENT are always set.",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "object",
                  "description": "Secret reference. Access to the secret is granted automatically.",
                  "additionalProperties": false,
                  "properties": {
                    "secret": {
                      "type": "string",
                      "description": "Secret ID, or \"projects/p/secrets/x\""
                    },
                    "version": {
                      "type": [
                        "string",
                        "integer"
                      ],
                      "description": "Default: latest"
                    }
                  },
                  "required": [
                    "secret"
                  ]
                }
              ]
            }
          },
          "labels": {
            "type": "object",
            "description": "GCP labels on this component's resources (cost reports, filtering). platform.yaml labels and the standard ones are added automatically.",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_-]{0,62}$",
              "not": {
                "enum": [
                  "product",
                  "workload",
                  "workload-type",
                  "env",
                  "team",
                  "managed-by"
                ]
              }
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{0,63}$"
            }
          },
          "permissions": {
            "type": "object",
            "description": "IAM for this component's service account, granted on each resource",
            "additionalProperties": false,
            "properties": {
              "public": {
                "type": "boolean",
                "description": "Anyone on the internet may call it (allUsers invoker)"
              },
              "invokers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Who may call it: component names or IAM members"
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "secretAccessor on each secret (env secrets are granted already)"
              },
              "buckets": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "read",
                    "write",
                    "admin"
                  ]
                },
                "description": "bucket: read | write | admin"
              },
              "publish": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "pubsub.publisher on each topic"
              },
              "subscribe": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "pubsub.subscriber on each subscription"
              },
              "bigquery_datasets": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "read",
                    "write"
                  ]
                },
                "description": "\"dataset\" or \"project:dataset\": read | write"
              },
              "project_roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Escape hatch: project-wide roles (reviewed)"
              }
            }
          },
          "calls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Apps/apis/functions this calls: grants run.invoker and injects <NAME>_URL"
          },
          "triggers": {
            "type": "object",
            "description": "Eventarc triggers",
            "additionalProperties": {
              "type": "object",
              "description": "One trigger",
              "additionalProperties": false,
              "properties": {
                "event_type": {
                  "type": "string",
                  "description": "e.g. google.cloud.storage.object.v1.finalized"
                },
                "filters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "pubsub_topic": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "event_type"
              ]
            }
          }
        }
      }
    }
  }
}
