                  },
                  "description": "Override container args for this schedule"
                },
                "paused": {
                  "type": "boolean"
                }
              },
              "required": [
                "cron"
              ]
            }
          },
          "execution_environment": {
            "enum": [
              "gen1",
              "gen2"
            ],
            "description": "Cloud Run execution environment (default: Cloud Run decides)"
          },
          "network": {
            "type": "object",
            "description": "Networking",
            "additionalProperties": false,
            "properties": {
              "egress": {
                "enum": [
                  "private-ranges",
                  "all-traffic",
                  "none"
                ],
                "description": "Outbound via the env's VPC: private IPs only (default), all traffic, or no VPC"
              }
            }
          },
          "env": {
            "type": "object",
            "description": "Env vars: a value, or a Secret Manager secret. ENV, PRODUCT, COMPONENT are always set.",
            "propertyNames": {
