{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "job.schema.json",
  "title": "deployment.yml (job)",
  "description": "A job: run-to-completion task, optionally scheduled. Runs as a Cloud Run job. Reference: docs/DEPLOYMENT_YML.md",
  "type": [
    "object",
    "null"
  ],
  "additionalProperties": false,
  "properties": {
    "template": {
      "type": "string",
      "description": "Scaffold this was created from (informational)"
    },
    "container": {
      "type": "object",
      "description": "How the container runs",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "CPU and memory per instance",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ],
          "description": "vCPUs: \"1\", \"2\", \"4\", \"8\" (services also \"0.5\")"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$",
          "description": "e.g. 512Mi, 2Gi"
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "How each execution runs",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "integer",
          "minimum": 1,
          "description": "Tasks per execution (default 1)"
        },
        "parallelism": {
          "type": "integer",
          "minimum": 0,
          "description": "Tasks at once (default 0 = all)"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Retries per failed task (default 3)"
        },
        "task_timeout": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^[0-9]+s$",
          "description": "Per task (default 600s)"
        }
      }
    },
    "schedules": {
      "type": "object",
      "description": "Cloud Scheduler triggers",
      "additionalProperties": {
        "type": "object",
        "description": "One schedule",
        "additionalProperties": false,
        "properties": {
          "cron": {
            "type": "string",
            "description": "e.g. \"0 2 * * *\""
          },
          "time_zone": {
            "type": "string",
            "description": "IANA name, default Etc/UTC"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Override container args for this schedule"
          },
          "paused": {
            "type": "boolean"
          }
        },
        "required": [
          "cron"
        ]
      }
    },
    "execution_environment": {
      "enum": [
        "gen1",
        "gen2"
      ],
      "description": "Cloud Run execution environment (default: Cloud Run decides)"
    },
    "network": {
      "type": "object",
      "description": "Networking",
      "additionalProperties": false,
      "properties": {
        "egress": {
          "enum": [
            "private-ranges",
            "all-traffic",
            "none"
          ],
          "description": "Outbound via the env's VPC: private IPs only (default), all traffic, or no VPC"
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Env vars: a value, or a Secret Manager secret. ENV, PRODUCT, COMPONENT are always set.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "object",
            "description": "Secret reference. Access to the secret is granted automatically.",
            "additionalProperties": false,
            "properties": {
              "secret": {
                "type": "string",
                "description": "Secret ID, or \"projects/p/secrets/x\""
              },
              "version": {
                "type": [
                  "string",
                  "integer"
                ],
                "description": "Default: latest"
              }
            },
            "required": [
              "secret"
            ]
          }
        ]
      }
    },
    "labels": {
      "type": "object",
      "description": "GCP labels on this component's resources (cost reports, filtering). platform.yaml labels and the standard ones are added automatically.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,62}$",
        "not": {
          "enum": [
            "product",
            "workload",
            "workload-type",
            "env",
            "team",
            "managed-by"
          ]
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{0,63}$"
      }
    },
    "permissions": {
      "type": "object",
      "description": "IAM for this component's service account, granted on each resource",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "secretAccessor on each secret (env secrets are granted already)"
        },
        "buckets": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "read",
              "write",
              "admin"
            ]
          },
          "description": "bucket: read | write | admin"
        },
        "publish": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "pubsub.publisher on each topic"
        },
        "subscribe": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "pubsub.subscriber on each subscription"
        },
        "bigquery_datasets": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "read",
              "write"
            ]
          },
          "description": "\"dataset\" or \"project:dataset\": read | write"
        },
        "project_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Escape hatch: project-wide roles (reviewed)"
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Apps/apis/functions this calls: grants run.invoker and injects <NAME>_URL"
    },
    "environments": {
      "type": "object",
      "description": "Per-env settings, deep-merged over the above (lists are replaced)",
      "propertyNames": {
        "enum": [
          "dev",
          "prod"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "container": {
            "type": "object",
            "description": "How the container runs",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "resources": {
            "type": "object",
            "description": "CPU and memory per instance",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "vCPUs: \"1\", \"2\", \"4\", \"8\" (services also \"0.5\")"
              },
              "memory": {
                "type": "string",
                "pattern": "^[0-9]+(Mi|Gi)$",
                "description": "e.g. 512Mi, 2Gi"
              }
            }
          },
          "execution": {
            "type": "object",
            "description": "How each execution runs",
            "additionalProperties": false,
            "properties": {
              "tasks": {
                "type": "integer",
                "minimum": 1,
                "description": "Tasks per execution (default 1)"
              },
              "parallelism": {
                "type": "integer",
                "minimum": 0,
                "description": "Tasks at once (default 0 = all)"
              },
              "max_retries": {
                "type": "integer",
                "minimum": 0,
                "description": "Retries per failed task (default 3)"
              },
              "task_timeout": {
                "type": [
                  "string",
                  "integer"
                ],
                "pattern": "^[0-9]+s$",
                "description": "Per task (default 600s)"
              }
            }
          },
          "schedules": {
            "type": "object",
