{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product.schema.json",
  "title": "product.yaml",
  "description": "Product-level settings. Components are the <section>/<name>/deployment.yml folders next to this file. Reference: docs/DEPLOYMENT_YML.md",
  "type": "object",
  "required": [
    "product",
    "team",
    "envs"
  ],
  "additionalProperties": false,
  "properties": {
    "product": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,9}$",
      "description": "2-10 chars, [a-z][a-z0-9]*. Prefix of every resource and SA name."
    },
    "team": {
      "type": "string",
      "description": "Owning team: GitHub team slug (CODEOWNERS) and label"
    },
    "envs": {
      "type": "array",
      "items": {
        "enum": [
          "dev",
          "prod"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "region": {
      "type": "string",
      "description": "Default: platform.yaml region"
    },
    "projects": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "dev",
          "prod"
        ]
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Per-env project ID if not {org}-{product}-{env}"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
