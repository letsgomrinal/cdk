{
  "config": {
    "deletion_protection": false,
    "deployers": [
      "serviceAccount:drone-release@acme-cicd.iam.gserviceaccount.com"
    ],
    "env": "dev",
    "functions": {
      "gcs-ingest": {
        "access": {
          "buckets": {
            "acme-orders-inbox-dev": "read"
          },
          "publish": [
            "orders-events"
          ]
        },
        "cpu": "1",
        "env": {
          "COMPONENT": "gcs-ingest",
          "ENV": "dev",
          "PRODUCT": "orders"
        },
        "ingress": "INGRESS_TRAFFIC_INTERNAL_ONLY",
        "max_instances": 20,
        "memory": "1Gi",
        "secret_env": {},
        "triggers": {
          "upload": {
            "event_type": "google.cloud.storage.object.v1.finalized",
            "filters": {
              "bucket": "acme-orders-inbox-dev"
            }
          }
        }
      }
    },
    "jobs": {
      "nightly-export": {
        "access": {
          "bigquery_datasets": {
            "orders_analytics": "write"
          },
          "buckets": {
            "acme-orders-exports-dev": "write"
          }
        },
        "args": [
          "export"
        ],
        "cpu": "2",
        "env": {
          "COMPONENT": "nightly-export",
          "ENV": "dev",
          "PRODUCT": "orders"
        },
        "max_retries": 2,
        "memory": "2Gi",
        "schedules": {
          "daily": {
            "cron": "0 2 * * *",
            "time_zone": "Europe/Berlin"
          }
        },
        "secret_env": {
          "DB_URL": "orders-db-url:latest"
        },
        "task_count": 1,
        "timeout": "3600s"
      },
      "reconcile": {
        "calls": [
          "service/backend"
        ],
        "cpu": "1",
        "env": {
          "COMPONENT": "reconcile",
          "ENV": "dev",
          "PRODUCT": "orders"
        },
        "memory": "512Mi",
        "parallelism": 2,
        "schedules": {
          "hourly": {
            "cron": "15 * * * *"
          },
          "weekly": {
            "args": [
              "--full"
            ],
            "cron": "0 4 * * 0"
          }
        },
        "secret_env": {},
        "task_count": 4,
        "timeout": "900s"
      }
    },
    "labels": {
      "cost-center": "cc-123"
    },
    "product": "orders",
    "project_id": "acme-orders-dev",
    "region": "europe-west1",
    "services": {
      "backend": {
        "access": {
          "publish": [
            "orders-events"
          ]
        },
        "concurrency": 80,
        "cpu": "1",
        "egress": "PRIVATE_RANGES_ONLY",
        "env": {
          "COMPONENT": "backend",
          "ENV": "dev",
          "LOG_LEVEL": "info",
          "PRODUCT": "orders"
        },
        "ingress": "INGRESS_TRAFFIC_INTERNAL_ONLY",
        "labels": {
          "data-classification": "pii",
          "tier": "critical"
        },
        "liveness_probe": {
          "http_path": "/healthz",
          "period_seconds": 30
        },
        "max_instances": 10,
        "memory": "1Gi",
        "secret_env": {
          "DB_URL": "orders-db-url:latest"
        },
        "startup_probe": {
          "failure_threshold": 10,
          "http_path": "/healthz",
          "period_seconds": 5
        },
        "timeout": "60s"
      },
      "storefront": {
        "calls": [
          "service/backend"
        ],
        "cpu": "1",
        "env": {
          "COMPONENT": "storefront",
          "ENV": "dev",
          "NEXT_TELEMETRY_DISABLED": "1",
          "PRODUCT": "orders"
        },
        "ingress": "INGRESS_TRAFFIC_ALL",
        "invokers": [
          "allUsers"
        ],
        "max_instances": 20,
        "memory": "512Mi",
        "min_instances": 0,
        "port": 8080,
        "secret_env": {},
        "startup_cpu_boost": true,
        "startup_probe": {
          "failure_threshold": 12,
          "http_path": "/",
          "period_seconds": 5
        }
      }
    },
    "team": "commerce",
    "vpc": {
      "network": "projects/acme-net-dev/global/networks/shared",
      "subnetwork": "projects/acme-net-dev/regions/europe-west1/subnetworks/serverless"
    },
    "worker_pools": {
      "email-sender": {
        "access": {
          "buckets": {
            "acme-orders-templates": "read"
          },
          "subscribe": [
            "orders-email-requests"
          ]
        },
        "cpu": "1",
        "egress": "ALL_TRAFFIC",
        "env": {
          "COMPONENT": "email-sender",
          "ENV": "dev",
          "PRODUCT": "orders",
          "SUBSCRIPTION": "projects/acme-orders-dev/subscriptions/orders-email-requests"
        },
        "instances": 1,
        "memory": "512Mi",
        "secret_env": {
          "SMTP_PASSWORD": "orders-smtp-password:3"
        }
      }
    }
  }
}
