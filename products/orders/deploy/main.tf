# GENERATED by `cdk sync`. Do not edit.
# Inputs: <env>.tfvars.json, compiled from ../../../platform.yaml, ../product.yaml and
# ../<section>/<name>/deployment.yml. Atlantis runs: plan -var-file=<env>.tfvars.json

terraform {
  required_version = ">= 1.7"
  required_providers {
    google = { source = "hashicorp/google", version = "~> 8.11" }
  }
  # bucket + prefix come from backend.<env>.hcl (Atlantis passes it at init)
  backend "gcs" {}
}

provider "google" {}

variable "config" {
  description = "The product for one env, as compiled by `cdk sync`"
  type        = any
}

module "product" {
  source = "../../../platform/terraform/modules/product"

  product             = var.config.product
  team                = var.config.team
  env                 = var.config.env
  project_id          = var.config.project_id
  region              = var.config.region
  labels              = var.config.labels
  vpc                 = var.config.vpc
  deployers           = var.config.deployers
  deletion_protection = var.config.deletion_protection

  services     = var.config.services
  jobs         = var.config.jobs
  worker_pools = var.config.worker_pools
  functions    = var.config.functions
}

output "workloads" {
  value = module.product.workloads
}
